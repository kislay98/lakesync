# lakesync configuration. Every setting is an environment variable.

# --- required ---
# Postgres for users, connections, pipelines, runs and logs (never for synced data).
DATABASE_URL=postgres://lakesync:lakesync@postgres:5432/lakesync?sslmode=disable
# 32-byte key for sealing secrets at rest (AES-256-GCM). Generate: `lakesync gen-key`.
APP_SECRET_KEY=
# The admin account, created on first boot when no user exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- http ---
LISTEN_ADDR=:8080
# Set in development: cookies are not marked Secure, so http://localhost works.
DEV_MODE=false
# Public URL (informational, used in docs and hints).
BASE_URL=

# --- network policy ---
# Allow destinations/sources on private networks (10/8, 172.16/12, 192.168/16, localhost).
# true for the local stack, false for a VM talking to Atlas and cloud storage.
ALLOW_PRIVATE_ENDPOINTS=true
# Public egress IP shown in the MongoDB Atlas allowlist hint (auto-detected when unset).
PUBLIC_IP=
DISABLE_IP_LOOKUP=false

# --- sync engine ---
DEFAULT_SYNC_INTERVAL_S=60
MIN_SYNC_INTERVAL_S=10
FLUSH_MAX_EVENTS=50000
FLUSH_MAX_MB=64
SNAPSHOT_CHUNK_SIZE=5000
SCHEMA_SAMPLE_SIZE=1000
# 0 = unlimited. Atlas Free allows 100 ops/s.
SNAPSHOT_MAX_DOCS_PER_SEC=0
FAILURE_THRESHOLD=5
FAILURE_WINDOW=10m

# --- sql console / viewer ---
QUERY_ROW_LIMIT=10000
QUERY_TIMEOUT=30s

# --- duckdb ---
# Bundled extensions directory (set in the container image; empty = DuckDB downloads them).
DUCKDB_EXTENSION_DIR=
DUCKDB_MEMORY_LIMIT=
DUCKDB_THREADS=0

# --- logging ---
LOG_LEVEL=info
LOG_FORMAT=json
