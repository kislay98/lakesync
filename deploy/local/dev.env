# Environment for running lakesync on the host against `make infra` (ports published by compose).
DATABASE_URL=postgres://lakesync:lakesync@localhost:5432/lakesync?sslmode=disable
LISTEN_ADDR=:8080
DEV_MODE=true
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-now
ALLOW_PRIVATE_ENDPOINTS=true
LOG_FORMAT=text
LOG_LEVEL=debug
