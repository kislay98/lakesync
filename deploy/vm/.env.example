# Copy to .env and fill in. Nothing else is needed on the VM.
DOMAIN=lakesync.example.com
ACME_EMAIL=you@example.com
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# 64 hex characters; generate with: docker run --rm ghcr.io/lakesync/lakesync gen-key
APP_SECRET_KEY=
POSTGRES_PASSWORD=choose-a-db-password
# Sources and destinations on private networks are refused unless this is true.
ALLOW_PRIVATE_ENDPOINTS=false
# Shown in the Atlas allowlist hint (auto-detected when empty).
PUBLIC_IP=
# Image to run (build your own with `make docker` or use a published tag).
LAKESYNC_IMAGE=ghcr.io/lakesync/lakesync:latest
